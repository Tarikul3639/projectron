# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3639

# MCP
MCP_HTTP_ENABLED=true
MCP_STDIO_ENABLED=false

# Filesystem
FILESYSTEM_ALLOWED_ROOTS=./workspace

# Logging
LOG_LEVEL=debug
# Set true to print full sanitized tool input/output and trace details in the terminal.
PROJECTRON_LOG_DETAILS=false
